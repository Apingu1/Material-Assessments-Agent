# Required
OPENAI_API_KEY=

# Recommended default for research quality/cost balance.
OPENAI_MODEL=gpt-5.6-terra

# Paths are relative to the repository root unless absolute.
# The DOCX template is used for the Cleaning Validation Material Hazard & Cleanability output.
# COSHH is generated programmatically as a concise, agent-friendly document.
TEMPLATE_PATH=ES.SOP.272.F01.V02 - Material Hazard & Cleanability Screening Assessment.docx
OUTPUT_DIR=outputs
DATABASE_PATH=data/agent.db

# Optional. Leave blank so the human operator can complete the cleaning-assessment field during review.
DEFAULT_ASSESSMENT_PERFORMED_BY=

# Evidence capture. The agent still produces evidence metadata if browser capture fails.
# BNF/NICE receives a dedicated browser-session attempt before the normal evidence waterfall.
CAPTURE_EVIDENCE=true
PLAYWRIGHT_TIMEOUT_MS=30000

# Optional: if LibreOffice is installed, both the Cleaning dossier and COSHH draft are exported to PDF.
GENERATE_PDF=true
